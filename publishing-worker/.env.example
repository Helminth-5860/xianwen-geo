APP_ENV=staging
HOST=0.0.0.0
PORT=8092

# Must be a public HTTPS URL in production. Expose only /authorize/* through the reverse proxy.
PUBLISHING_WORKER_PUBLIC_BASE_URL=https://example.com/publishing-auth

# Use an independent random secret of at least 32 characters. Never reuse Django SECRET_KEY.
PUBLISHING_WORKER_INTERNAL_SECRET=replace-with-independent-random-secret-at-least-32-chars

# Keep empty until each browser platform passes real-account acceptance.
PUBLISHING_WORKER_EXPERIMENTAL_PLATFORM_KEYS=

PUBLISHING_WORKER_BROWSER_HEADLESS=true

# 4C8G staging default: only one real publication action at a time.
PUBLISHING_WORKER_MAX_CONCURRENCY=1
PUBLISHING_WORKER_MAX_QUEUE=20
