    "@types/node": "26.1.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.12",
    "jsdom": "^26.1.0",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
