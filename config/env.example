# Application
APP_ENV=local
APP_NAME=xianwen-geo
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:8000
DJANGO_SECRET_KEY=replace-via-secret-manager
DJANGO_DEBUG=false
ALLOWED_HOSTS=localhost
CSRF_TRUSTED_ORIGINS=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Database - use managed PostgreSQL in production
DATABASE_URL=postgresql://app_user:password@postgres-host:5432/xianwen_geo
DATABASE_CONN_MAX_AGE=60

# Redis - use managed Redis in production
REDIS_URL=rediss://:password@redis-host:6379/0
CELERY_BROKER_URL=rediss://:password@redis-host:6379/1
CELERY_RESULT_BACKEND=django-db

# Session / security
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAMESITE=Lax
CSRF_COOKIE_SECURE=true
ADMIN_SESSION_TIMEOUT_SECONDS=3600
USER_SESSION_TIMEOUT_SECONDS=1209600
FIELD_ENCRYPTION_MASTER_KEY=replace-via-secret-manager
API_CREDENTIAL_ENVIRONMENT=staging
VIDEO_PROVIDER=unavailable
VIDEO_MODEL=wan2.6-i2v-flash
VIDEO_RESOLUTION=720P
VIDEO_SOURCE_IMAGE_MAX_BYTES=20971520
VIDEO_MAX_BYTES=134217728
VIDEO_JOB_LEASE_SECONDS=390
VIDEO_IDEMPOTENCY_HMAC_KEY=replace-via-secret-manager
ALIYUN_VIDEO_API_BASE_URL=
ALIYUN_VIDEO_API_KEY=replace-via-secret-manager
GEO_DETECTION_IDEMPOTENCY_HMAC_KEY=replace-via-secret-manager
GEO_DETECTION_GLOBAL_MAX_CONCURRENCY=32
GEO_DETECTION_QUEUE_TIMEOUT_SECONDS=900
GEO_DETECTION_DISPATCH_BATCH=100
GEO_DETECTION_INTERNAL_MAX_RETRIES=3

# COS
COS_REGION=ap-guangzhou
COS_BUCKET=replace-after-provisioning
COS_SECRET_ID=replace-via-secret-manager
COS_SECRET_KEY=replace-via-secret-manager
COS_PRIVATE_ENDPOINT=
COS_SIGNED_URL_TTL_SECONDS=600

# SMS
SMS_PROVIDER=tencent
SMS_APP_ID=
SMS_SECRET_ID=replace-via-secret-manager
SMS_SECRET_KEY=replace-via-secret-manager
SMS_SIGN_NAME=
SMS_TEMPLATE_REGISTER=
SMS_TEMPLATE_LOGIN=
SMS_TEMPLATE_SECURITY=
SMS_TEMPLATE_REVIEW=
SMS_TEMPLATE_PLAN_EXPIRY=

# AI credentials: use secret manager or encrypted admin entry in production.
# These variables are for local development only and must never be committed with real values.
DEEPSEEK_API_KEY=
DOUBAO_API_KEY=
QWEN_API_KEY=
HUNYUAN_API_KEY=
WENXIN_API_KEY=
KIMI_API_KEY=
GLM_API_KEY=
SPARK_API_KEY=

# AI model IDs - verify against official accounts before production
DEEPSEEK_DETECTION_MODEL_ID=
DEEPSEEK_SCORING_MODEL_ID=
DEEPSEEK_TEXT_MODEL_ID=
DOUBAO_DETECTION_MODEL_ID=
DOUBAO_IMAGE_MODEL_ID=
QWEN_DETECTION_MODEL_ID=
HUNYUAN_DETECTION_MODEL_ID=
WENXIN_DETECTION_MODEL_ID=
KIMI_DETECTION_MODEL_ID=
GLM_DETECTION_MODEL_ID=
SPARK_DETECTION_MODEL_ID=

# Content moderation
CONTENT_MODERATION_PROVIDER=
CONTENT_MODERATION_API_KEY=replace-via-secret-manager

# Observability
LOG_LEVEL=INFO
SENTRY_DSN=
METRICS_ENABLED=true

# Email is optional in V1
EMAIL_BACKEND=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=replace-via-secret-manager

# Feature flags
ENABLE_REAL_AI_ADAPTERS=false
ENABLE_REAL_SMS=false
ENABLE_COS=false
ENABLE_IMAGE_GENERATION=false
ENABLE_WEB_SEARCH=true

# XW-0208 subject AI enrichment mock flow
SUBJECT_ENRICHMENT_PROVIDER=mock
SUBJECT_ENRICHMENT_IDEMPOTENCY_HMAC_KEY=replace-with-independent-random-subject-enrichment-hmac-key
SUBJECT_ENRICHMENT_MAX_SOURCES=8
SUBJECT_ENRICHMENT_MAX_SOURCE_CHARACTERS=20000
SUBJECT_ENRICHMENT_MAX_TOTAL_SOURCE_CHARACTERS=80000
SUBJECT_ENRICHMENT_MAX_TARGET_FIELDS=20
SUBJECT_ENRICHMENT_PROVIDER_TIMEOUT_SECONDS=30
SUBJECT_ENRICHMENT_MAX_PROVIDER_ATTEMPTS=3
SUBJECT_ENRICHMENT_RETRY_BASE_SECONDS=30
SUBJECT_ENRICHMENT_RUNNING_STALE_SECONDS=120
SUBJECT_ENRICHMENT_INTERNAL_MAX_RETRIES=3
