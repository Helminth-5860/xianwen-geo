{
  "schema_version": "1.0",
  "limits": [
    {"key": "subject_active_limit", "type": "integer", "scope": "account", "description": "可启用主体数量"},
    {"key": "allowed_model_keys", "type": "string_array", "scope": "account", "description": "可使用检测模型"},
    {"key": "max_models_per_detection", "type": "integer", "scope": "task", "description": "单次最多选择模型数"},
    {"key": "max_questions_per_detection", "type": "integer", "scope": "task", "description": "单次检测问题上限"},
    {"key": "concurrent_detection_jobs", "type": "integer", "scope": "account", "description": "用户并发检测任务数"},
    {"key": "queue_priority", "type": "integer", "scope": "account", "description": "检测队列优先级，数值越高优先级越高"},
    {"key": "detection_points", "type": "integer", "scope": "subscription", "description": "检测点总额度"},
    {"key": "article_credits", "type": "integer", "scope": "subscription", "description": "文章额度"},
    {"key": "image_credits", "type": "integer", "scope": "subscription", "description": "图片额度"},
    {"key": "keyword_generation_limit", "type": "integer", "scope": "subject", "description": "每主体原始关键词生成上限"},
    {"key": "question_bank_limit", "type": "integer", "scope": "subject", "description": "每主体问题库数量上限"},
    {"key": "keyword_regenerations_per_cycle", "type": "integer", "scope": "subject_cycle", "description": "关键词重新生成次数"},
    {"key": "distillation_regenerations_per_cycle", "type": "integer", "scope": "subject_cycle", "description": "关键词蒸馏重新执行次数"},
    {"key": "question_bank_regenerations_per_cycle", "type": "integer", "scope": "subject_cycle", "description": "问题库重新生成次数"},
    {"key": "strategy_regenerations_per_cycle", "type": "integer", "scope": "subject_cycle", "description": "改善策略重新生成次数"},
    {"key": "outline_regenerations_per_cycle", "type": "integer", "scope": "subject_cycle", "description": "文章大纲重新生成次数"},
    {"key": "local_ai_edits_per_cycle", "type": "integer", "scope": "subject_cycle", "description": "局部AI修改次数"},
    {"key": "quality_rechecks_per_cycle", "type": "integer", "scope": "subject_cycle", "description": "文章质量复检次数"},
    {"key": "assistant_messages_per_cycle", "type": "integer", "scope": "account_cycle", "description": "显问AI助手回复次数"},
    {"key": "storage_bytes", "type": "integer", "scope": "account", "description": "账号总存储空间"},
    {"key": "white_label_enabled", "type": "boolean", "scope": "account", "description": "是否允许白标报告"},
    {"key": "report_export_enabled", "type": "boolean", "scope": "account", "description": "是否允许导出报告"},
    {"key": "report_share_enabled", "type": "boolean", "scope": "account", "description": "是否允许分享报告"},
    {"key": "business_record_retention_days", "type": "integer_or_null", "scope": "account", "description": "业务记录保留天数，null表示永久"},
    {"key": "subject_trash_days", "type": "integer", "scope": "account", "description": "主体回收站天数"},
    {"key": "image_trash_days", "type": "integer", "scope": "account", "description": "图片回收站天数"},
    {"key": "document_retention_days_after_expiry", "type": "integer_or_null", "scope": "account", "description": "套餐到期后资料保留天数，null表示永久"},
    {"key": "document_expiry_action", "type": "enum", "scope": "account", "values": ["delete_immediately", "move_to_trash"], "description": "资料保留期结束动作"},
    {"key": "document_trash_days", "type": "integer", "scope": "account", "description": "资料回收站天数"},
    {"key": "expiry_quota_policy", "type": "json", "scope": "subscription", "description": "套餐到期各额度清零、冻结或保留策略"}
  ]
}
