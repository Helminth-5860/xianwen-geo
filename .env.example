APP_ENV=local
DJANGO_SECRET_KEY=local-development-only-change-before-deployment
DJANGO_DEBUG=true
SECURE_SSL_REDIRECT=false
ALLOWED_HOSTS=localhost,127.0.0.1,api
CSRF_TRUSTED_ORIGINS=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000
POSTGRES_DB=xianwen_geo
POSTGRES_USER=xianwen
POSTGRES_PASSWORD=local-development-only
DATABASE_URL=postgresql://xianwen:local-development-only@postgres:5432/xianwen_geo
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
SMS_PROVIDER=mock
SMS_VERIFICATION_HMAC_KEY=replace-with-random-local-sms-hmac-key
QUOTA_IDEMPOTENCY_HMAC_KEY=replace-with-random-local-quota-idempotency-key
PLAN_CHANGE_IDEMPOTENCY_HMAC_KEY=replace-with-random-local-plan-change-idempotency-key
SMS_CODE_TTL_SECONDS=300
SMS_RESEND_COOLDOWN_SECONDS=60
SMS_MAX_ATTEMPTS=5
SMS_LIMIT_COMBINATION_COUNT=5
SMS_LIMIT_COMBINATION_WINDOW_SECONDS=900
SMS_LIMIT_PHONE_COUNT=10
SMS_LIMIT_PHONE_WINDOW_SECONDS=3600
SMS_LIMIT_IP_COUNT=60
SMS_LIMIT_IP_WINDOW_SECONDS=3600
TRUSTED_PROXY_HOPS=0
TRUSTED_PROXY_CIDRS=
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900
LOGIN_RATE_LIMIT_LOCK_SECONDS=900
LOGIN_RATE_LIMIT_COMBINATION_FAILURES=5
LOGIN_RATE_LIMIT_PHONE_FAILURES=10
LOGIN_RATE_LIMIT_IP_FAILURES=30
ADMIN_CHALLENGE_TTL_SECONDS=300
ADMIN_REAUTH_LIMIT_FAILURES=5
ADMIN_REAUTH_LIMIT_WINDOW_SECONDS=900
RISK_APPROVAL_TTL_SECONDS=86400
NEXT_PUBLIC_APP_ENV=local
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1


# Private file storage (local S3-compatible MinIO; never use these placeholders in production)
FILE_IDEMPOTENCY_HMAC_KEY=replace-with-independent-random-file-idempotency-key
FILE_STORAGE_PROVIDER=s3
FILE_SCANNER_PROVIDER=mock
DOCUMENT_OCR_PROVIDER=mock
DOCUMENT_PARSE_MAX_CHARACTERS=2000000
DOCUMENT_PARSE_MAX_UTF8_BYTES=8388608
DOCUMENT_PARSE_MAX_TABLES=100
DOCUMENT_PARSE_MAX_TABLE_ROWS=10000
DOCUMENT_PARSE_MAX_TABLE_COLUMNS=200
DOCUMENT_PARSE_MAX_CELL_CHARACTERS=10000
DOCUMENT_PARSE_MAX_TABLE_JSON_BYTES=8388608
DOCUMENT_PARSE_RETRY_BASE_SECONDS=30
DOCUMENT_PARSE_RUNNING_STALE_SECONDS=600
DOCUMENT_PARSE_INTERNAL_MAX_RETRIES=3
FILE_UPLOAD_MAX_BYTES=52428800
FILE_UPLOAD_URL_TTL=300
FILE_DOWNLOAD_URL_TTL=300
FILE_STAGING_RETENTION_SECONDS=3600
FILE_ALLOWED_APP_ORIGINS=http://localhost:3000
S3_ENDPOINT_URL=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=xianwen-files-local
S3_ACCESS_KEY=replace-with-random-local-minio-access-key
S3_SECRET_KEY=replace-with-random-local-minio-secret-key